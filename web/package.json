{
  "name": "drone-simulator",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "无人机模拟器：Cesium 三维地图 + 六自由度刚体飞行 + 碰撞与空气流场",
  "scripts": {
    "assets": "node scripts/prepare-assets.mjs",
    "dev": "npm run assets && vite",
    "server": "node ../server/index.mjs",
    "smoke": "node ../server/smoke.mjs",
    "build": "npm run assets && vue-tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 5199 --strictPort",
    "typecheck": "vue-tsc --noEmit",
    "check": "node scripts/check-cesium.mjs",
    "check:flow": "node scripts/check-flow.mjs",
    "check:gimbal": "node scripts/check-gimbal.mjs",
    "check:acro": "node scripts/check-acro.mjs",
    "check:locate": "node scripts/check-locate.mjs",
    "check:terrain": "node scripts/check-terrain.mjs",
    "check:terrain-collision": "node scripts/check-terrain-collision.mjs",
    "check:google3d": "node scripts/check-google3d.mjs",
    "check:tiles": "node scripts/check-tiles.mjs",
    "check:audio": "node scripts/check-audio.mjs",
    "buildings": "node scripts/fetch-buildings.mjs"
  },
  "dependencies": {
    "@mapbox/vector-tile": "^3.0.0",
    "cesium": "1.147.0",
    "pbf": "^5.1.2",
    "socket.io-client": "^4.8.4",
    "vue": "^3.5.45"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.11",
    "typescript": "~5.9.0",
    "vite": "^7.3.8",
    "vue-tsc": "^3.3.14"
  }
}
